# Without the option, candle and reagent stay where they are put (the
# reagent on top of the candle)
args: --map 12 --pos 18540,15900,40
do: option:pentagram_snap,off;t5;sendto:21561,12,18560,15930,40;sendto:21569,12,18500,15950,40;t2
do: drag:21561:309,236;where:21561;drag:21569:319,238;t30;where:21569
expect: where 21561: 18630,16034,40
reject: where 21569: 18661,15999,40
