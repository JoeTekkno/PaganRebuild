# Option "outline when hidden": only his helmet still shows over the wall.
# At "mostly" (80 %) no outline is drawn yet, at "a little" (25 %) it is
args: --map 50 --pos 5763,2410,48
do: option:map_fade,off;option:avatar_outline,3;t5;outline;option:avatar_outline,1;outline
expect: outline: 0 pixels
expect: outline: 608 pixels
