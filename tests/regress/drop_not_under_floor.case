# A thing put down by the thin wall at Bane's pentacle stays on the floor:
# lower than the floor under the pointer only where nothing carries there
# (a flat floor has no height; it landed below it, on height 0)
args: --map 12 --pos 18540,15900,40
do: option:pentagram_snap,off;option:pentagram_reach,on;t5;sendto:21569,12,18500,15950,40;drag:21569:298,248;t40;where:21569
expect: where 21569: 18624,16072,40
